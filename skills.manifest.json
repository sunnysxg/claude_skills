{
  "version": 1,
  "supported_platforms": ["windows", "linux"],
  "source_root": ".",
  "native_clients": {
    "claude": "~/.claude/skills",
    "opencode": "~/.claude/skills"
  },
  "clients": {
    "cursor": {
      "root": "~/.cursor/skills",
      "enabled_by_default": true,
      "windows_link_type": "junction",
      "unix_link_type": "symlink"
    },
    "codex": {
      "root": "~/.agents/skills",
      "enabled_by_default": true,
      "windows_link_type": "junction",
      "unix_link_type": "symlink"
    },
    "antigravity": {
      "root": "~/.gemini/config/skills.json",
      "enabled_by_default": true,
      "windows_link_type": "antigravity_skills_json",
      "unix_link_type": "antigravity_skills_json"
    }
  },
  "managed_rules": [
    {
      "name": "global-common",
      "source": "global/COMMON.md",
      "platforms": ["windows", "linux"],
      "targets": [
        {
          "client": "cursor",
          "path": "~/.cursor/rules/claude-skills-common.mdc",
          "mode": "cursor_mdc"
        },
        {
          "client": "codex",
          "path": "~/.codex/AGENTS.md",
          "mode": "managed_block",
          "legacy_exact_content": "@skills/global/AGENTS.md"
        },
        {
          "client": "antigravity",
          "path": "~/.gemini/AGENTS.md",
          "mode": "managed_include",
          "include_line": "@[Global Common Rules](~/.claude/skills/global/COMMON.md)"
        }
      ]
    }
  ],
  "skills": [
    {
