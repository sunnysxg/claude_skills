      "source": "article-ingest",
      "platforms": ["windows", "linux"],
      "targets": ["cursor", "codex", "antigravity"],
      "compatibility": {
        "cursor": "compatible",
        "codex": "compatible",
        "antigravity": "compatible",
        "windows": "ssh_fetch_only",
        "linux": "local_fetch"
      }
    },
