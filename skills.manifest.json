{
  "version": 1,
  "supported_platforms": ["windows", "linux"],
  "source_root": ".",
  "native_clients": {
    "claude": "~/.claude/skills",
    "opencode": "~/.claude/skills"
  },
  "clients": {
    "cursor": {
      "root": "~/.cursor/skills",
      "enabled_by_default": true,
      "windows_link_type": "junction",
      "unix_link_type": "symlink"
    },
    "codex": {
      "root": "~/.agents/skills",
      "enabled_by_default": true,
      "windows_link_type": "junction",
      "unix_link_type": "symlink"
    }
  },
  "managed_rules": [
    {
      "name": "global-common",
      "source": "global/COMMON.md",
      "platforms": ["windows", "linux"],
      "targets": [
        {
          "client": "cursor",
          "path": "~/.cursor/rules/claude-skills-common.mdc",
          "mode": "cursor_mdc"
        },
        {
          "client": "codex",
          "path": "~/.codex/AGENTS.md",
          "mode": "managed_block",
          "legacy_exact_content": "@skills/global/AGENTS.md"
        }
      ]
    }
  ],
  "skills": [
    {
      "name": "git-workflow",
      "source": "git-workflow",
      "platforms": ["windows", "linux"],
      "targets": ["cursor", "codex"],
      "compatibility": {
        "cursor": "compatible",
        "codex": "compatible"
      }
    },
    {
      "name": "handoff",
      "source": "handoff",
      "platforms": ["windows", "linux"],
      "targets": ["cursor", "codex"],
      "compatibility": {
        "cursor": "compatible",
        "codex": "compatible"
      }
    },
    {
      "name": "lq",
      "source": "lq",
      "platforms": ["windows", "linux"],
      "targets": ["cursor", "codex"],
      "compatibility": {
        "cursor": "compatible",
        "codex": "compatible"
      }
    },
    {
      "name": "mmd-explain",
      "source": "mmd-explain",
      "platforms": ["windows", "linux"],
      "targets": ["cursor", "codex"],
      "compatibility": {
        "cursor": "tested",
        "codex": "tested",
        "windows": "powershell_renderer",
        "linux": "bash_renderer"
      }
    },
    {
      "name": "neat-freak",
      "source": "neat-freak",
      "platforms": ["windows", "linux"],
      "targets": ["cursor", "codex"],
      "compatibility": {
        "cursor": "compatible",
        "codex": "tested"
      }
    },
    {
      "name": "pickup",
      "source": "pickup",
      "platforms": ["windows", "linux"],
      "targets": ["cursor", "codex"],
      "compatibility": {
        "cursor": "compatible",
        "codex": "compatible"
      }
    },
    {
      "name": "playground",
      "source": "playground",
      "platforms": ["windows", "linux"],
      "targets": ["cursor", "codex"],
      "compatibility": {
        "cursor": "compatible",
        "codex": "compatible"
      }
    },
    {
      "name": "session-log",
      "source": "session-log",
      "platforms": ["windows", "linux"],
      "targets": ["cursor"],
      "compatibility": {
        "cursor": "tested",
        "codex": "requires_codex_transcript_support"
      }
    },
    {
      "name": "session-search",
      "source": "session-search",
      "platforms": ["windows", "linux"],
      "targets": ["cursor", "codex"],
      "compatibility": {
        "cursor": "compatible",
        "codex": "compatible"
      }
    }
  ],
